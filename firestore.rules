rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // Posts and Threads
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.title is string && request.resource.data.title.size() <= 300;
      allow update: if true;
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.content is string && request.resource.data.content.size() <= 2000;
        allow update: if true;
        allow delete: if isAdmin();

        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.resource.data.content is string && request.resource.data.content.size() <= 2000;
          allow update: if true;
          allow delete: if isAdmin();
        }
      }
    }

    // Blocking System (Only Admins can write directly; normal users auto-block via server API)
    match /blockedIps/{ip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedImeis/{imei} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User reports
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.reason is string;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // User & System Interactions
    match /interactions/{interactionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Communities and Cohorts
    match /communities/{communityId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow update: if true;
      allow delete: if isAdmin();

      match /chats/{chatId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if true;
          allow delete: if isAdmin();
        }
      }

      match /visits/{ip} {
        allow read, write: if true;
      }
    }
  }
}
