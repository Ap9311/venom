rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Verification Collection
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.data.isAdmin == true;
    }

    // Function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // Administrator Device Registry & Configuration Collections
    match /admin_devices/{deviceId} {
      allow read, write: if isAdmin();
    }

    match /admin_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Interactions Collection (public read/create for feed & user interactions; admin write protection for admin records)
    match /interactions/{interactionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (!interactionId.matches('^admin_.*'));
    }

    // User Reports (public creation, admin-only read and management)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Blocking System (public read to enforce client checks, admin-only management)
    match /blockedIps/{ip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedImeis/{imei} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Posts and Threads
    match /posts/{postId} {
      allow read, create, update, delete: if true;

      match /comments/{commentId} {
        allow read, create, update, delete: if true;

        match /replies/{replyId} {
          allow read, create, update, delete: if true;
        }
      }
    }

    // Public Communities
    match /communities/{communityId} {
      allow read, create, update, delete: if true;

      match /chats/{chatId} {
        allow read, create, update, delete: if true;

        match /comments/{commentId} {
          allow read, create, update, delete: if true;
        }
      }

      match /visits/{ip} {
        allow read, write: if true;
      }
    }

    // System Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
