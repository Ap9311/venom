rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Verification Collection
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.data.secretKey == "V3n0m!@#2026AdminSecureKey!!";
    }

    // Function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // Posts and Threads
    match /posts/{postId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();

        match /replies/{replyId} {
          allow read, create, update: if true;
          allow delete: if isAdmin();
        }
      }
    }

    // Blocking System (Only Admins can block)
    match /blockedIps/{ip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedImeis/{imei} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User reports (Anyone can submit, only admins should ideally delete, but keeping simple)
    match /reports/{reportId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Interactions
    match /interactions/{interactionId} {
      allow read, write: if true;
    }

    // Communities
    match /communities/{communityId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /chats/{chatId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();

        match /comments/{commentId} {
          allow read, create, update: if true;
          allow delete: if isAdmin();
        }
      }

      match /visits/{ip} {
        allow read, write: if true;
      }
    }
  }
}
