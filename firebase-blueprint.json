{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "An anonymous Nonum post (text, image, poll, or Q&A) with zero user PII.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["text", "image", "poll", "qa"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "pollOptions": { "type": "array" },
        "pollVotes": { "type": "object" },
        "correctOptionIndex": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "upvotesCount": { "type": "integer" },
        "downvotesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "reactions": { "type": "object" },
        "reportsCount": { "type": "integer" },
        "isDeleted": { "type": "boolean" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "encryptedHash": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["type", "title", "content", "likesCount", "upvotesCount", "downvotesCount", "commentsCount", "createdAt", "encryptedHash"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A privacy-safe anonymous comment on a post.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "likesCount": { "type": "integer" },
        "repliesCount": { "type": "integer" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "likesCount", "repliesCount", "createdAt"]
    },
    "Reply": {
      "title": "Reply",
      "description": "A privacy-safe anonymous reply to a comment.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "likesCount": { "type": "integer" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "likesCount", "createdAt"]
    },
    "BlockedDevice": {
      "title": "BlockedDevice",
      "description": "Moderator-managed firewall suspension record (moderator-only access).",
      "type": "object",
      "properties": {
        "isBlocked": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "blockedAt": { "type": "string", "format": "date-time" },
        "blockType": { "type": "string" },
        "reason": { "type": "string" },
        "blockCount": { "type": "integer" },
        "totalReports": { "type": "integer" },
        "triggerPostId": { "type": "string" }
      },
      "required": ["isBlocked"]
    },
    "Report": {
      "title": "Report",
      "description": "A privacy-safe moderation report filed against a post or community (moderator-only read).",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "communityId": { "type": "string" },
        "chatId": { "type": "string" },
        "postTitle": { "type": "string" },
        "postContent": { "type": "string" },
        "postImageUrl": { "type": "string" },
        "reason": { "type": "string" },
        "opinion": { "type": "string" },
        "reporterUid": { "type": "string" },
        "isDismissed": { "type": "boolean" },
        "isResolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reason", "createdAt"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Per-UID anonymous interaction record (likes, votes, polls, reactions, pins, unlocks).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "postId": { "type": "string" },
        "chatId": { "type": "string" },
        "communityId": { "type": "string" },
        "type": { "type": "string" },
        "direction": { "type": "string" },
        "optionIndex": { "type": "integer" },
        "reactionKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "type", "createdAt"]
    },
    "Community": {
      "title": "Community",
      "description": "An anonymous community channel. PIN secrets are stored separately server-side.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "religion": { "type": "string" },
        "userLimit": { "type": "integer" },
        "allowUserPost": { "type": "boolean" },
        "hasPin": { "type": "boolean" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reportsCount": { "type": "integer" },
        "isBlocked": { "type": "boolean" },
        "viewsCount": { "type": "integer" }
      },
      "required": ["name", "allowUserPost", "createdAt", "reportsCount", "isBlocked", "viewsCount"]
    },
    "CommunitySecret": {
      "title": "CommunitySecret",
      "description": "Server-only scrypt PIN hash for PIN-locked communities (admin/server only).",
      "type": "object",
      "properties": {
        "pinHash": { "type": "string" },
        "ownerUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pinHash", "updatedAt"]
    },
    "CommunityChat": {
      "title": "CommunityChat",
      "description": "A privacy-safe message dispatch inside a community.",
      "type": "object",
      "properties": {
        "communityId": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "poll", "qa"] },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "pollOptions": { "type": "array" },
        "pollVotes": { "type": "object" },
        "correctOptionIndex": { "type": "integer" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "encryptedHash": { "type": "string" },
        "likesCount": { "type": "integer" },
        "reactions": { "type": "object" },
        "commentsCount": { "type": "integer" }
      },
      "required": ["communityId", "type", "content", "createdAt", "encryptedHash", "likesCount", "commentsCount"]
    },
    "CommunityChatComment": {
      "title": "CommunityChatComment",
      "description": "A comment on a community chat message.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "ownerUid": { "type": "string" },
        "likesCount": { "type": "integer" },
        "repliesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "createdAt"]
    },
    "CommunityVisit": {
      "title": "CommunityVisit",
      "description": "Per-UID unique community member visit marker.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "visitedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "visitedAt"]
    },
    "AdminClaim": {
      "title": "AdminClaim",
      "description": "Server-issued short-lived Firestore role bridge document (never client-writable without server bridge key).",
      "type": "object",
      "properties": {
        "isAdmin": { "type": "boolean" },
        "role": { "type": "string", "enum": ["admin", "assistant"] },
        "serverAuthKey": { "type": "string" },
        "expiresAt": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["isAdmin", "role", "serverAuthKey", "expiresAt"]
    },
    "AdminDevice": {
      "title": "AdminDevice",
      "description": "Registered administrative device identifier managed strictly by server APIs.",
      "type": "object",
      "properties": {
        "adminDeviceId": { "type": "string" },
        "os": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "label": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] }
      },
      "required": ["adminDeviceId", "registeredAt", "status"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Admin slot limit and server-side scrypt assistant credentials.",
      "type": "object",
      "properties": {
        "maxAdmins": { "type": "integer" },
        "usernameDisplay": { "type": "string" },
        "usernameHash": { "type": "string" },
        "passwordHash": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "RateLimitRecord": {
      "title": "RateLimitRecord",
      "description": "Server-only authentication lockout record keyed by HMAC-hashed IP.",
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "lockedUntil": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["count", "lockedUntil", "updatedAt"]
    }
  },
  "firestore": {
    "/private_config/{docId}": {
      "schema": "AdminConfig",
      "description": "Server bridge secret referenced exclusively by Firestore rules (no client read/write)."
    },
    "/admins/{uid}": {
      "schema": "AdminClaim",
      "description": "Short-lived server-validated role claims for admin and assistant sessions."
    },
    "/admin_devices/{deviceId}": {
      "schema": "AdminDevice",
      "description": "Registered admin devices (full admin & server only)."
    },
    "/admin_config/{configId}": {
      "schema": "AdminConfig",
      "description": "Global admin configuration and assistant credentials (full admin & server only)."
    },
    "/community_secrets/{communityId}": {
      "schema": "CommunitySecret",
      "description": "Server-side scrypt PIN hashes for locked communities (full admin & server only)."
    },
    "/rate_limits/{key}": {
      "schema": "RateLimitRecord",
      "description": "Authentication rate-limit state keyed by HMAC-SHA256 IP hash (server only)."
    },
    "/blocked_ip_hashes/{ipHash}": {
      "schema": "BlockedDevice",
      "description": "Salted HMAC-hashed IP block records (full admin & server only)."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public anonymous posts feed."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on a post."
    },
    "/posts/{postId}/comments/{commentId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "Replies on a post comment."
    },
    "/blockedIps/{ip}": {
      "schema": "BlockedDevice",
      "description": "Moderator-managed IP firewall rules (moderator-only access)."
    },
    "/blockedImeis/{imei}": {
      "schema": "BlockedDevice",
      "description": "Legacy moderator-managed device firewall rules (moderator-only access)."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User-submitted content reports (signed-in create, moderator-only read/manage)."
    },
    "/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "UID-scoped anonymous user interaction records."
    },
    "/communities/{communityId}": {
      "schema": "Community",
      "description": "Public anonymous communities."
    },
    "/communities/{communityId}/chats/{chatId}": {
      "schema": "CommunityChat",
      "description": "Messages posted inside a community."
    },
    "/communities/{communityId}/chats/{chatId}/comments/{commentId}": {
      "schema": "CommunityChatComment",
      "description": "Comments on a community chat message."
    },
    "/communities/{communityId}/chats/{chatId}/comments/{commentId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "Replies to comments on a community chat message."
    },
    "/communities/{communityId}/visits/{visitId}": {
      "schema": "CommunityVisit",
      "description": "UID-scoped unique member visit tracker."
    }
  }
}
