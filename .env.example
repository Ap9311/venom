# ==============================================================================
# Nonum Server Environment Variables (Configure in Vercel / Production Host)
# NEVER commit real secrets, passwords, hashes, or private paths to git.
# ==============================================================================

# REQUIRED: 64-char random hex secret used to sign short-lived admin & assistant JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, all admin/assistant auth endpoints fail closed (HTTP 500).
ADMIN_SECRET_KEY=

# REQUIRED: Primary administrator username (server-only, never exposed to client).
ADMIN_USERNAME=

# REQUIRED (provide EITHER ADMIN_PASSWORD_HASH or ADMIN_PASSWORD):
# Recommended format: scrypt$<32-char-hex-salt>$<64-char-hex-key>
# Generate with:
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex'),h=c.scryptSync('YOUR_STRONG_PASSWORD',s,32).toString('hex');console.log('scrypt$'+s+'$'+h)"
ADMIN_PASSWORD_HASH=
# Optional fallback if not pre-hashed (compared via scrypt + timingSafeEqual on server):
ADMIN_PASSWORD=

# REQUIRED for Assistant Portal baseline credentials (overridable from Admin Audit):
ASSISTANT_USERNAME=
ASSISTANT_PASSWORD_HASH=
ASSISTANT_PASSWORD=

# REQUIRED for Assistant Portal routing (keep secret; never hardcode in client JS).
# Example format: /your-secret-segment/panel
ASSISTANT_PORTAL_PATH=

# RECOMMENDED: Separate 64-char random hex salt for HMAC-SHA256 hashing of client IPs
# used in server-side rate limiting and abuse blocks.
IP_HASH_SALT=

# OPTIONAL: Server-only owner IP allowlist (comma-separated if multiple).
# Never exposed to the browser or stored in client code.
OWNER_IP=

# OPTIONAL: 64-char random hex bridge secret matching Firestore document
# private_config/server_auth { key: "<same secret>" } so server endpoints can
# grant/revoke short-lived Firestore moderation claims without exposing secrets.
FIRESTORE_BRIDGE_KEY=

# OPTIONAL: Override default max registered admin devices (default: 3).
MAX_ADMIN_DEVICES=3
